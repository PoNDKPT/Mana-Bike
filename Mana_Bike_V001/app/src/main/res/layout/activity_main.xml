<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mana_background"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/headerSummary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="56dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@+id/tvDemoBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_chip"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:text="@string/demo_badge"
            android:textColor="@color/mana_navy"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/summary_label"
            android:textColor="@color/mana_pale"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvTotalAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:textColor="@color/white"
            android:textSize="40sp"
            android:textStyle="bold"
            tools:text="฿48,250.00" />

        <TextView
            android:id="@+id/tvSelectedMonth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:textColor="@color/mana_navy"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="พฤศจิกายน 2569" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerSummary">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPrevYear"
                        style="@style/Widget.ManaBike.ArrowButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="@string/prev_year"
                        android:text="‹" />

                    <TextView
                        android:id="@+id/tvYear"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textColor="@color/mana_navy"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="2569" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNextYear"
                        style="@style/Widget.ManaBike.ArrowButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="@string/next_year"
                        android:text="›" />
                </LinearLayout>

                <GridLayout
                    android:id="@+id/gridMonths"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="4">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMonth1"
                        style="@style/Widget.ManaBike.MonthButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:text="@string/month_short_1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMonth2"
                        style="@style/Widget.ManaBike.MonthButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:text="@string/month_short_2" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMonth3"
                        style="@style/Widget.ManaBike.MonthButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:text="@string/month_short_3" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMonth4"
                        style="@style/Widget.ManaBike.MonthButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:text="@string/month_short_4" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMonth5"
                        style="@style/Widget.ManaBike.MonthButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:text="@string/month_short_5" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMonth6"
                        style="@style/Widget.ManaBike.MonthButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:text="@string/month_short_6" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMonth7"
                        style="@style/Widget.ManaBike.MonthButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:text="@string/month_short_7" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMonth8"
                        style="@style/Widget.ManaBike.MonthButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:text="@string/month_short_8" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMonth9"
                        style="@style/Widget.ManaBike.MonthButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:text="@string/month_short_9" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMonth10"
                        style="@style/Widget.ManaBike.MonthButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:text="@string/month_short_10" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMonth11"
                        style="@style/Widget.ManaBike.MonthButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:text="@string/month_short_11" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMonth12"
                        style="@style/Widget.ManaBike.MonthButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:text="@string/month_short_12" />

                </GridLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stat_count"
                        android:textColor="@color/mana_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/mana_navy"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="126" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stat_avg"
                        android:textColor="@color/mana_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvAvgPerDay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/mana_blue"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="฿6,893" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="8dp"
        app:itemActiveIndicatorStyle="@style/Widget.ManaBike.ActiveIndicator"
        app:itemIconTint="@color/nav_item"
        app:itemTextColor="@color/nav_item"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav_menu" />
</androidx.constraintlayout.widget.ConstraintLayout>
