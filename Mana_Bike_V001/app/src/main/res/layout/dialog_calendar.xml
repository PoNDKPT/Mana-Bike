<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/calPrev"
            style="@style/Widget.ManaBike.ArrowButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/prev_month"
            android:text="‹" />

        <TextView
            android:id="@+id/calMonth"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:focusable="true"
            android:gravity="center"
            android:textColor="@color/mana_navy"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="พฤศจิกายน 2569 ▾" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/calNext"
            style="@style/Widget.ManaBike.ArrowButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/next_month"
            android:text="›" />
    </LinearLayout>

    <!-- แผงวัน -->
    <LinearLayout
        android:id="@+id/calDayPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="อา"
                android:textColor="@color/mana_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="จ"
                android:textColor="@color/mana_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="อ"
                android:textColor="@color/mana_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="พ"
                android:textColor="@color/mana_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="พฤ"
                android:textColor="@color/mana_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="ศ"
                android:textColor="@color/mana_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="ส"
                android:textColor="@color/mana_muted"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <GridLayout
            android:id="@+id/calGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="7" />
    </LinearLayout>

    <!-- แผงเลือกปี/เดือน (แตะชื่อเดือนด้านบนเพื่อเปิด) -->
    <LinearLayout
        android:id="@+id/calMonthPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/calYearPrev"
                style="@style/Widget.ManaBike.ArrowButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/prev_year"
                android:text="‹" />

            <TextView
                android:id="@+id/calYear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/mana_navy"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="2569" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/calYearNext"
                style="@style/Widget.ManaBike.ArrowButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/next_year"
                android:text="›" />
        </LinearLayout>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="4">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/calM1"
                style="@style/Widget.ManaBike.MonthButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="@string/month_short_1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/calM2"
                style="@style/Widget.ManaBike.MonthButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="@string/month_short_2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/calM3"
                style="@style/Widget.ManaBike.MonthButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="@string/month_short_3" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/calM4"
                style="@style/Widget.ManaBike.MonthButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="@string/month_short_4" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/calM5"
                style="@style/Widget.ManaBike.MonthButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="@string/month_short_5" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/calM6"
                style="@style/Widget.ManaBike.MonthButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="@string/month_short_6" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/calM7"
                style="@style/Widget.ManaBike.MonthButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="@string/month_short_7" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/calM8"
                style="@style/Widget.ManaBike.MonthButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="@string/month_short_8" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/calM9"
                style="@style/Widget.ManaBike.MonthButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="@string/month_short_9" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/calM10"
                style="@style/Widget.ManaBike.MonthButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="@string/month_short_10" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/calM11"
                style="@style/Widget.ManaBike.MonthButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="@string/month_short_11" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/calM12"
                style="@style/Widget.ManaBike.MonthButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="@string/month_short_12" />
        </GridLayout>
    </LinearLayout>
</LinearLayout>
